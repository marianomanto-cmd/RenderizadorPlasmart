{
  "$meta": {
    "name": "Plasmart Design System",
    "codename": "Signal",
    "theme": "dark-only",
    "locale": "es-AR"
  },
  "color": {
    "bg": "#08090b",
    "bg-2": "#0d0f13",
    "panel": "#111419",
    "text": "#eef0f3",
    "muted": "#8a8f99",
    "faint": "#4f545d",
    "line": "rgba(255,255,255,.10)",
    "line-2": "rgba(255,255,255,.20)",
    "accent": "#6e7bff",
    "accent-soft": "rgba(110,123,255,.6)",
    "accent-12": "rgba(110,123,255,.12)",
    "white": "#ffffff",
    "wa-green": "#25d366"
  },
  "font": {
    "display": "\"Sora\", system-ui, -apple-system, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", monospace"
  },
  "weight": {
    "thin": 200,
    "light": 300,
    "regular": 400,
    "medium": 500,
    "semi": 600
  },
  "fontSize": {
    "hero": "clamp(44px, 9vw, 150px)",
    "display": "clamp(44px, 11vw, 200px)",
    "h1": "clamp(34px, 5.6vw, 88px)",
    "h2": "clamp(30px, 4vw, 62px)",
    "h3": "clamp(28px, 3.4vw, 52px)",
    "mani": "clamp(28px, 4.4vw, 72px)",
    "stat": "clamp(40px, 6vw, 90px)",
    "lead": "clamp(17px, 1.5vw, 21px)",
    "body": "17px",
    "sm": "15px",
    "xs": "14px",
    "mono": "12px",
    "mono-sm": "11px",
    "mono-lg": "13px"
  },
  "lineHeight": {
    "hero": 0.94,
    "tight": 0.98,
    "snug": 1.12,
    "body": 1.55,
    "relaxed": 1.6
  },
  "letterSpacing": {
    "mega": "-.05em",
    "hero": "-.04em",
    "tight": "-.035em",
    "snug": "-.03em",
    "body": "-.01em",
    "label": ".1em",
    "kicker": ".22em"
  },
  "layout": {
    "maxw": "1480px",
    "pad": "clamp(20px, 4.5vw, 80px)"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px",
    "9": "96px"
  },
  "sectionY": {
    "base": "clamp(80px, 13vh, 180px)",
    "lg": "clamp(120px, 22vh, 280px)"
  },
  "radius": {
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "pill": "100px"
  },
  "border": {
    "width": "1px"
  },
  "shadow": {
    "none": "none",
    "glow-accent": "0 0 12px rgba(110,123,255,.6)",
    "glow-accent-sm": "0 0 8px rgba(110,123,255,.6)",
    "nav": "0 10px 30px rgba(0,0,0,.35)",
    "pop": "0 24px 60px rgba(0,0,0,.5)"
  },
  "motion": {
    "ease": "cubic-bezier(.19, 1, .22, 1)",
    "easeOut": "cubic-bezier(.16, 1, .3, 1)",
    "fast": "250ms",
    "base": "350ms",
    "slow": "550ms",
    "panel": "800ms"
  },
  "effect": {
    "blurGlass": "blur(12px)",
    "grainOpacity": 0.04
  }
}